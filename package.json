{
  "name": "rosefd",
  "version": "0.1.8",
  "description": "The next-century web framework: zero-hydration, compile-time reactivity, single binary deploy",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli/index.ts dev example",
    "build": "tsx src/cli/index.ts build example",
    "preview": "tsx src/cli/index.ts preview example",
    "serve": "tsx src/cli/index.ts serve example",
    "pack": "node pack.mjs",
    "prepublishOnly": "npm run pack",
    "benchmark": "tsx tests/benchmark.ts",
    "test": "tsx src/cli/index.ts build example && tsx tests/test-client.ts",
    "test:cli": "node tests/test-cli.mjs",
    "test:e2e": "tsx tests/test-e2e.ts",
    "test:edge": "tsx tests/test-edge.ts",
    "test:harness": "tsx tests/test-harness.ts",
    "test:go": "tsx src/cli/index.ts build example && node tests/test-go.mjs",
    "test:pack": "node tests/test-pack.mjs",
    "build:go": "go build -o rosefd-server ."
  },
  "bin": {
    "rosefd": "dist-cli/rosefd.mjs"
  },
  "exports": {
    "./edge": "./dist-cli/edge.mjs",
    "./runtime": "./dist-cli/runtime.mjs",
    "./compiler": "./dist-cli/compiler.mjs",
    "./test": "./dist-cli/test.mjs"
  },
  "files": [
    "dist-cli",
    "src",
    "pack.mjs",
    "LICENSE",
    "deploy/api",
    "deploy/cloudflare",
    "deploy/k8s",
    "deploy/netlify",
    "deploy/Dockerfile.node",
    "deploy/Dockerfile.static",
    "deploy/docker-compose.yml",
    "deploy/fly.toml",
    "deploy/netlify.toml",
    "deploy/server.cjs",
    "deploy/vercel.json",
    "devtools/devtools.html",
    "devtools/devtools.js",
    "devtools/manifest.json",
    "devtools/panel.html",
    "devtools/panel.js",
    "templates/admin/package.json",
    "templates/admin/rosefd.config.js",
    "templates/admin/src",
    "templates/api/package.json",
    "templates/api/rosefd.config.js",
    "templates/api/src",
    "templates/blog/package.json",
    "templates/blog/rosefd.config.js",
    "templates/blog/src",
    "templates/site/package.json",
    "templates/site/rosefd.config.js",
    "templates/site/src"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "esbuild": "^0.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  }
}