<script>
  const docEntry = globalThis.__rosefdContent.get("docs", "getting-started");
  const docList = () => globalThis.__rosefdContent.list("docs");
</script>

<h1>Docs</h1>
<ul>
  {#each docList() as d}
  <li>{d.title}</li>
  {/each}
</ul>
<p>Reading time: {docEntry.readingTime} min · {docEntry.wordCount} words</p>
{#each docEntry.toc as t}
<a href={"#" + t.id}>{t.text}</a>
{/each}
<div>{@html globalThis.__rosefdContent.get("docs", "getting-started", { siteName: "Rose Frame Driver", version: "0.4.8" }).html}</div>
